# .env.example — copy to .env and fill in values for private registry access.
# This file is safe to commit. The .env file must NOT be committed.
#
# For the default alpine:latest demo, NO credentials are required.
# Only fill these in if you are pulling from a private registry.

# Optional: private registry credentials
# These are used by `container registry login` / `podman login`.
# Leave blank to use public images only.
REGISTRY_HOST=
REGISTRY_USERNAME=
REGISTRY_PASSWORD=

# Optional: override the default demo image
DEMO_IMAGE=alpine:latest

# Optional: number of benchmark iterations (1–10)
BENCHMARK_ITERATIONS=3
