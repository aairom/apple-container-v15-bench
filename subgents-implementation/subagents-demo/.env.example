# ─────────────────────────────────────────────────────────────────────────────
# Sub-Agents Demo – Environment Variables
# Copy this file to .env and fill in the real values before running.
# NEVER commit the actual .env file to source control.
# ─────────────────────────────────────────────────────────────────────────────

# ── LLM Backend selection ─────────────────────────────────────────────────────
# Choose the inference backend: ollama | llamacpp | openai
# (LLM_PROVIDER is accepted as a legacy alias for LLM_BACKEND)
LLM_BACKEND=ollama

# ── Ollama (LLM_BACKEND=ollama, default) ─────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# ── llama.cpp (LLM_BACKEND=llamacpp) ─────────────────────────────────────────
# Absolute path to your GGUF model file.
# Download example: https://huggingface.co/TheBloke/Llama-3-8B-Instruct-GGUF
#   e.g. models/llama-3-8b-instruct.Q4_K_M.gguf
LLAMACPP_MODEL_PATH=/path/to/your/model.Q4_K_M.gguf
# Context window size (tokens). 4096 is a safe default.
LLAMACPP_N_CTX=4096
# GPU layers to offload (0 = CPU only; set to 999 for full GPU offload)
LLAMACPP_N_GPU_LAYERS=0
# Max tokens the model will generate per call
LLAMACPP_MAX_TOKENS=512
# Sampling temperature (0.0 = deterministic, 1.0 = creative)
LLAMACPP_TEMPERATURE=0.7

# ── OpenAI (LLM_BACKEND=openai) ──────────────────────────────────────────────
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o

# ── Orchestrator settings ─────────────────────────────────────────────────────
# Directory whose Python files the explore-agent will analyse
TARGET_CODEBASE_DIR=input

# Directory where the unified report will be written
OUTPUT_DIR=output

# Human-readable project name used in the generated report
PROJECT_NAME=Sub-Agents Demo – Sample Codebase

# ── Web UI (src/ui.py) ────────────────────────────────────────────────────────
# Port for the Streamlit UI (default: 8501 – avoids macOS AirDrop port 5000)
UI_PORT=8501

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
